{
  "name": "relay",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/dev-server.ts",
    "build": "vite build",
    "start": "bun src/internal-server.ts",
    "start:public": "bun src/public-webhook-server.ts",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint .",
    "format:check": "oxfmt --check src tests package.json tsconfig.json vite.config.ts svelte.config.js",
    "format": "oxfmt src tests package.json tsconfig.json vite.config.ts svelte.config.js",
    "test": "bun test",
    "validate": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/bun": "^1.2.0",
    "oxfmt": "^0.22.0",
    "oxlint": "^1.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
