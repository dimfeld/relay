PUBLIC_PORT=4310
INTERNAL_PORT=4311
DATABASE_PATH=./data/relay.sqlite
PEBBLE_WEBHOOK_SECRETS=replace-with-a-long-random-secret
PEBBLE_MAX_BODY_BYTES=65536
PEBBLE_RATE_LIMIT_PER_MINUTE=30
# Each service has its own token. Capabilities: events:publish, coding:request, deploy:request, admin:read.
INTERNAL_SERVICE_CREDENTIALS='{"mail":{"token":"replace-with-a-long-random-token","capabilities":["events:publish"]},"omniapp":{"token":"replace-with-another-long-random-token","capabilities":["events:publish"]}}'
INTERNAL_API_MAX_BODY_BYTES=65536
# Optional JSON file that lists approved projects. See README.md for its format.
# PROJECTS_CONFIG_PATH=./projects.json
DELIVERY_MAX_ATTEMPTS=10
WAKE_NAME=Tim
DEFAULT_EXECUTOR=codex
CODEX_EXECUTABLE=codex
CLAUDE_EXECUTABLE=claude
# Classification worker only. Keep these keys out of the public listener environment.
TYPESAFE_API_KEY=replace-with-typesafe-api-key
OPENAI_API_KEY=replace-with-openai-api-key
JEV_MODEL=jev-latest
LUNA_MODEL=gpt-6-luna
CLASSIFIER_CONTEXT_LIMIT=10
CLASSIFIER_CONTEXT_MAX_AGE_MINUTES=15
TIME_ZONE=America/Los_Angeles
